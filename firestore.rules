rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /plots/{plotId} {
      allow read, write: if true;

      match /payments/{paymentId} {
        allow read, write: if true;
      }
    }
    match /locations/{locationId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
